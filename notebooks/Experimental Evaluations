# ============================================================
# 9. POLICY 3 — DECENTRALIZED MULTI-AGENT HEURISTIC
# ============================================================
#
# Every traffic signal independently:
#
#   1. Examines each available phase.
#   2. Estimates the queue associated with that phase.
#   3. Selects the phase serving the largest queue.
#
# This is a decentralized heuristic.
#
# It is NOT:
#   - PPO
#   - MAPPO
#   - trained MARL
#   - learned policy
#
# It is a benchmark controller for the architecture developed
# in Module 06.
# ============================================================

def run_multi_agent(
    steps=SIM_STEPS,
    decision_interval=DECISION_INTERVAL,
    seed=RANDOM_SEED,
):
    """
    Evaluate the decentralized multi-agent queue-based
    heuristic controller.
    """

    start_sumo(seed)

    traffic_lights = list(
        traci.trafficlight.getIDList()
    )

    if len(traffic_lights) == 0:
        close_sumo()

        raise RuntimeError(
            "No traffic lights found for multi-agent policy."
        )

    queue_history = []
    waiting_history = []
    vehicle_history = []

    try:

        for step in range(steps):

            if (
                traci.simulation
                .getMinExpectedNumber()
                <= 0
            ):
                break

            # Agents make decisions at fixed intervals.
            if step % decision_interval == 0:

                for tls_id in traffic_lights:

                    program_logics = (
                        traci.trafficlight
                        .getAllProgramLogics(
                            tls_id
                        )
                    )

                    if len(program_logics) == 0:
                        raise RuntimeError(
                            f"No signal program found "
                            f"for '{tls_id}'."
                        )

                    phases = (
                        program_logics[0]
                        .getPhases()
                    )

                    if len(phases) == 0:
                        raise RuntimeError(
                            f"No phases found "
                            f"for '{tls_id}'."
                        )

                    phase_scores = []

                    for phase_index in range(
                        len(phases)
                    ):

                        score = get_phase_queue(
                            tls_id,
                            phase_index,
                        )

                        phase_scores.append(
                            score
                        )

                    # Choose the phase associated with
                    # the largest currently estimated queue.
                    action = int(
                        np.argmax(
                            phase_scores
                        )
                    )

                    traci.trafficlight.setPhase(
                        tls_id,
                        action,
                    )

            traci.simulationStep()

            queue, waiting, vehicles = (
                get_network_metrics()
            )

            queue_history.append(queue)
            waiting_history.append(waiting)
            vehicle_history.append(vehicles)

    finally:
        close_sumo()

    return summarize_policy_metrics(
        "multi_agent_heuristic",
        queue_history,
        waiting_history,
        vehicle_history,
    )


multi_agent_result = run_multi_agent()

print(
