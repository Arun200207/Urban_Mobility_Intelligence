# ============================================================
# 8. POLICY 2 — CYCLIC CONTROL
# ============================================================
#
# Every DECISION_INTERVAL steps, each traffic light advances
# through its available phases in a deterministic cycle.
#
# This is a simple non-learning control baseline.
# ============================================================

def run_cyclic(
    steps=SIM_STEPS,
    decision_interval=DECISION_INTERVAL,
    seed=RANDOM_SEED,
):
    """
    Evaluate deterministic cyclic signal control.
    """

    start_sumo(seed)

    traffic_lights = list(
        traci.trafficlight.getIDList()
    )

    if len(traffic_lights) == 0:
        close_sumo()

        raise RuntimeError(
            "No traffic lights found for cyclic policy."
        )

    phase_counts = {}

    for tls_id in traffic_lights:

        program_logics = (
            traci.trafficlight
            .getAllProgramLogics(tls_id)
        )

        if len(program_logics) == 0:
            close_sumo()

            raise RuntimeError(
                f"No signal program found for '{tls_id}'."
            )

        phase_counts[tls_id] = len(
            program_logics[0].getPhases()
        )

    queue_history = []
    waiting_history = []
    vehicle_history = []

    try:

        for step in range(steps):

            if (
                traci.simulation
                .getMinExpectedNumber()
                <= 0
            ):
                break

            # Update all signals at the configured
            # decision interval.
            if step % decision_interval == 0:

                cycle_index = (
                    step // decision_interval
                )

                for tls_id in traffic_lights:

                    action = (
                        cycle_index
                        % phase_counts[tls_id]
                    )

                    traci.trafficlight.setPhase(
                        tls_id,
                        action,
                    )

            traci.simulationStep()

            queue, waiting, vehicles = (
                get_network_metrics()
            )

            queue_history.append(queue)
            waiting_history.append(waiting)
            vehicle_history.append(vehicles)

    finally:
        close_sumo()

    return summarize_policy_metrics(
        "cyclic",
        queue_history,
        waiting_history,
        vehicle_history,
    )


cyclic_result = run_cyclic()

