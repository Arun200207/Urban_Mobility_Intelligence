def start_sumo(seed=RANDOM_SEED):
    """
    Start a fresh SUMO instance with a deterministic seed.
    """

    sumo_cmd = [
        "sumo",
        "-c",
        str(CONFIG_FILE),
        "--start",
        "--quit-on-end",
        "--seed",
        str(seed),
    ]

    try:
        traci.start(sumo_cmd)

    except Exception as exc:
        raise RuntimeError(
            "Failed to start SUMO for evaluation."
        ) from exc


def close_sumo():
    """
    Safely close the current TraCI connection.
    """

    try:
        traci.close()
    except Exception:
        pass


# ============================================================
# 6. METRIC AGGREGATION
# ============================================================

def summarize_policy_metrics(
    policy_name,
    queue_history,
    waiting_history,
    vehicle_history,
):
    """
    Convert raw time-series measurements into summary metrics.
    """

    if len(queue_history) == 0:
        raise RuntimeError(
            f"No queue measurements recorded for "
            f"policy '{policy_name}'."
        )

    return {
        "policy": policy_name,
        "average_queue": float(
            np.mean(queue_history)
        ),
        "maximum_queue": float(
            np.max(queue_history)
        ),
        "average_waiting_time": float(
            np.mean(waiting_history)
        ),
        "maximum_waiting_time": float(
            np.max(waiting_history)
        ),
        "average_vehicles": float(
            np.mean(vehicle_history)
        ),
        "peak_vehicles": int(
            np.max(vehicle_history)
        ),
        "simulation_steps": len(queue_history),
    }


# ============================================================
# 7. POLICY 1 — FIXED-TIME BASELINE
# ============================================================
#
# SUMO's configured/default signal program is allowed to run
# without external phase-control actions.
#
# This provides the reference baseline.
# ============================================================

def run_fixed_time(
    steps=SIM_STEPS,
    seed=RANDOM_SEED,
):
    """
    Evaluate SUMO's default/fixed-time signal control.
    """

    start_sumo(seed)

    queue_history = []
    waiting_history = []
    vehicle_history = []

    try:

        for _ in range(steps):

            if (
                traci.simulation
                .getMinExpectedNumber()
                <= 0
            ):
                break

            traci.simulationStep()

            queue, waiting, vehicles = (
                get_network_metrics()
            )

            queue_history.append(queue)
            waiting_history.append(waiting)
            vehicle_history.append(vehicles)

    finally:
        close_sumo()

    return summarize_policy_metrics(
        "fixed_time",
        queue_history,
        waiting_history,
        vehicle_history,
    )


fixed_result = run_fixed_time()

print("\nFixed-time evaluation completed.")
