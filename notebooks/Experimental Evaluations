# ============================================================
# 3. NETWORK METRICS
# ============================================================

def get_network_metrics():
    """
    Collect network-level traffic metrics from SUMO.

    Returns
    -------
    tuple
        total_queue:
            Total halted vehicles across all lanes.

        total_waiting:
            Total lane waiting time reported by SUMO.

        vehicles:
            Number of vehicles currently present in the network.
    """

    total_queue = 0.0
    total_waiting = 0.0

    for lane_id in traci.lane.getIDList():

        total_queue += (
            traci.lane.getLastStepHaltingNumber(
                lane_id
            )
        )

        total_waiting += (
            traci.lane.getWaitingTime(
                lane_id
            )
        )

    vehicles = traci.vehicle.getIDCount()

    return (
        float(total_queue),
        float(total_waiting),
        int(vehicles),
    )


# ============================================================
# 4. SIGNAL-PHASE QUEUE ESTIMATION
# ============================================================

def get_phase_queue(tls_id, phase_index):
    """
    Estimate the queue associated with green movements of a
    traffic-signal phase.

    Parameters
    ----------
    tls_id : str
        SUMO traffic-light identifier.

    phase_index : int
        Signal phase index.

    Returns
    -------
    float
        Estimated queue served by the selected phase.
    """

    program_logics = (
        traci.trafficlight.getAllProgramLogics(
            tls_id
        )
    )

    if len(program_logics) == 0:
        raise RuntimeError(
            f"No signal program found for '{tls_id}'."
        )

    logic = program_logics[0]
    phases = logic.getPhases()

    if phase_index < 0 or phase_index >= len(phases):
        raise ValueError(
            f"Invalid phase {phase_index} for '{tls_id}'."
        )

    phase = phases[phase_index]

    controlled_links = (
        traci.trafficlight.getControlledLinks(
            tls_id
        )
    )

    queue = 0.0

    for signal_index, signal_state in enumerate(
        phase.state
    ):

        if signal_index >= len(controlled_links):
            break

        # Consider green movements only.
        if signal_state not in ("G", "g"):
            continue

        links = controlled_links[signal_index]

        if links is None:
            continue

        for link in links:

            if link is None:
                continue

            lane_id = link[0]

            if lane_id is None:
                continue

            queue += (
                traci.lane.getLastStepHaltingNumber(
                    lane_id
                )
            )

    return float(queue)


